# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud, paste the same keys into
# App settings -> Secrets instead of committing this file.

TURSO_DATABASE_URL = "libsql://your-db-name-yourorg.turso.io"
TURSO_AUTH_TOKEN = "your-turso-auth-token"

# Used to build the public evaluation link that gets encoded in the QR code.
# This should be the base URL of THIS deployed app, e.g.
# "https://dbes-post-eval.streamlit.app"
APP_BASE_URL = "http://localhost:8501"
